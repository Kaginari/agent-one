# The release image: the static binary on a small Debian base that has bash (the agent's shell).
# No RUN steps, so the multi-platform build needs no emulation.
FROM debian:bookworm-slim
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/agent-one /usr/local/bin/agent-one
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/agent-one"]
